ARRAY_LEN = 16
N_BITS    = 16
SIGNED    = True

class SharingScheme:
    @staticmethod
    def populate(arr, n):
        @for_range(n)
        def _(i):
            share = sint(0)
            @for_range(3)
            def _(p):
                share.iadd(sint.get_input_from(p))
            arr[i] = share

program.set_bit_length(N_BITS)
a = sint.Array(ARRAY_LEN)
print_ln('--- Populating secret-shared array (additive, 3 parties) ---')
SharingScheme.populate(a, ARRAY_LEN)
print_ln('Before sort (revealed): %s', a.get_vector(0, ARRAY_LEN).reveal())
print_ln('--- Sorting (secret) ---')
a.sort(n_bits=N_BITS, signed=SIGNED)
print_ln('After  sort (revealed): %s', a.get_vector(0, ARRAY_LEN).reveal())
print_ln('Done.')
